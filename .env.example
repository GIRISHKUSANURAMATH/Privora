# Umbra configuration. Copy to .env and adjust. Every variable is optional.
# Where datasets, model artifacts, reports and the SQLite metadata DB are stored.
PPML_DATA_DIR=./data
# Bind address. Keep 127.0.0.1: the API has no authentication.
PPML_HOST=127.0.0.1
PPML_PORT=8000
# Host headers accepted (DNS-rebinding protection). JSON list.
PPML_ALLOWED_HOSTS=["127.0.0.1","localhost","[::1]"]
# Upload and dataset limits.
PPML_MAX_UPLOAD_MB=20
PPML_MAX_ROWS=200000
PPML_MAX_COLUMNS=200
# Number of experiments that may train at the same time.
PPML_MAX_CONCURRENT_JOBS=1
# auto | cpu | cuda
PPML_DEVICE=auto
# 0 = let PyTorch decide the number of CPU threads.
PPML_TORCH_THREADS=0
PPML_LOG_LEVEL=INFO
